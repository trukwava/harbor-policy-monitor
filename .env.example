# Offline demonstration. No API keys or services are required.
DEMO_MODE=true
HOST=127.0.0.1
PORT=4173
DB_PATH=./data/harbor.sqlite
# Live retrieval of administrator-approved HTTPS sources is OFF by default and
# fixture replay stays deterministic. Only 'enabled' turns it on; any value other
# than 'enabled' or 'disabled' refuses to start. See README "Approved-source live adapter".
LIVE_FETCH=disabled
# JSON array of approved source policies, read at start-up only when LIVE_FETCH=enabled.
# It is the only way to create a live allowlist; HTTP requests never supply URLs or hosts.
# LIVE_SOURCES_FILE=./config/approved-sources.json
